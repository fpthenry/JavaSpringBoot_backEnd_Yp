<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Viết tay (2026-11-17): cấu hình chung của website dạng khóa/giá trị (SiteSetting).
        Khóa đầu tiên: tet_effect = true/false (hiệu ứng Tết hoa đào trên yp.vn). Chưa có dòng = tắt.
    -->
    <changeSet id="20261117120000-1" author="claude">
        <createTable tableName="site_setting">
            <column name="setting_key" type="varchar(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="setting_value" type="varchar(2000)"/>
            <column name="updated_at" type="${datetimeType}"/>
            <column name="updated_by" type="varchar(100)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
