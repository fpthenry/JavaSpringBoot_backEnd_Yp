    <!--
        Added the constraints for entity ListingImage.
    -->
    <changeSet id="20260930094108-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="listing_id"
                                 baseTableName="listing_image"
                                 constraintName="fk_listing_image__listing_id"
