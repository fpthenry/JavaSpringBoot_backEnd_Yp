<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">
    <!--
        Added the constraints for entity Listing.
    -->
    <changeSet id="20260930094107-2" author="jhipster">

        <addForeignKeyConstraint baseColumnNames="author_id"
                                 baseTableName="listing"
                                 constraintName="fk_listing__author_id"
                                 referencedColumnNames="id"
                                 referencedTableName="jhi_user"
                                 />

        <addForeignKeyConstraint baseColumnNames="listing_id"
                                 baseTableName="rel_listing__categories"
                                 constraintName="fk_rel_listing__categories__listing_id"
                                 referencedColumnNames="id"
                                 referencedTableName="listing"
                                 />

        <addForeignKeyConstraint baseColumnNames="categories_id"
                                 baseTableName="rel_listing__categories"
                                 constraintName="fk_rel_listing__categories__categories_id"
                                 referencedColumnNames="id"
                                 referencedTableName="category"
                                 />

        <addForeignKeyConstraint baseColumnNames="listing_id"
                                 baseTableName="rel_listing__locations"
                                 constraintName="fk_rel_listing__locations__listing_id"
                                 referencedColumnNames="id"
                                 referencedTableName="listing"
                                 />

        <addForeignKeyConstraint baseColumnNames="locations_id"
                                 baseTableName="rel_listing__locations"
                                 constraintName="fk_rel_listing__locations__locations_id"
                                 referencedColumnNames="id"
                                 referencedTableName="location"
                                 />
    </changeSet>
</databaseChangeLog>
