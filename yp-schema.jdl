/**
 * Yellow Pages Vietnam - JDL
 * Bám đúng schema chuẩn MySQL `jhipster_vnyp` (bản backup 2026-10-01):
 * tên bảng/cột, kiểu dữ liệu, độ dài, NOT NULL, UNIQUE và quan hệ.
 *
 *   jhipster_vnyp            -> JHipster
 *   listing                  -> Listing
 *   category                 -> Category      (cây cha/con qua parent_id)
 *   location                 -> Location      (province -> district -> ward)
 *   blog_post                -> BlogPost
 *   tag                      -> Tag
 *   listing_category         -> rel_listing__category (listing_id, category_id)
 *   listing_location         -> rel_listing__location (listing_id, location_id)
 *   jhi_user / jhi_authority / jhi_user_authority -> built-in của JHipster
 *
 * Tên field camelCase -> cột snake_case trùng nguồn (wpId -> wp_id, locationJson -> location_json...).
 * Tên quan hệ ManyToMany để số ít (category, location) để cột nối là category_id / location_id;
 * JHipster 9.3.0 luôn thêm tiền tố rel_ cho bảng nối, JDL không đổi được tên bảng nối.
 *
 * Không đưa vào app (bảng phục vụ migrate từ WordPress, chỉ giữ ở jhipster_vnyp):
 *   staging_listing, migration_log
 *
 * JDL không biểu diễn được (xử lý bằng changelog Liquibase viết tay sau khi generate):
 *   - index thường: slug, status, tax_code, api_id, is_featured, type, parent_id
 *   - ON DELETE CASCADE của listing_category / listing_location
 *   - DEFAULT: status 'publish', view_count 0, is_featured 0, listing_count 0, CURRENT_TIMESTAMP
 */

// =====================================================
// 1. DOANH NGHIỆP
// =====================================================

/** Doanh nghiệp (bảng listing) */
entity Listing(listing) {
    /** ID bài viết WordPress (wp_posts.ID) */
    wpId Long required unique
    /** ID từ API nguồn */
    apiId String maxlength(100)

    name String required maxlength(500)
    nameEn String maxlength(500)
    nameAlias String maxlength(500)
    /** Không unique: dữ liệu gốc có slug NULL và trùng */
    slug String maxlength(500)
    description TextBlob

    // Liên hệ
    phone String maxlength(100)
    mobile String maxlength(100)
    email String maxlength(255)
    website String maxlength(500)

    // Địa chỉ
    address TextBlob
    /** JSON gốc: province, ward, street, province_code, ward_code, coordinate dạng lat:long (giữ nguyên dạng text) */
    locationJson TextBlob

    // Thông tin doanh nghiệp
    taxCode String maxlength(100)
    representative String maxlength(255)
    capital String maxlength(100)
    /** Dạng text gốc (vd 2024-01-11), không ép kiểu ngày */
    foundedYear String maxlength(50)
    businessType String maxlength(100)
    businessStatus String maxlength(50)
    industryCode String maxlength(100)
    managedBy String maxlength(255)

    // Hình ảnh (ID attachment WordPress)
    thumbnail String maxlength(500)
    images TextBlob

    // Trạng thái
    viewCount Integer
    isFeatured Boolean
    /** publish, draft */
    status String maxlength(50)

    // Thời gian
    publishedAt Instant
    modifiedAt Instant
    createdAt Instant
    updatedAt Instant

    esIndexed Boolean
}

// =====================================================
// 2. TAXONOMY
// =====================================================

/** Ngành nghề (bảng category) */
entity Category(category) {
    /** wp_terms.term_id */
    wpTermId Long unique
    name String required maxlength(255)
    slug String maxlength(255)
    description TextBlob
    icon String maxlength(255)
    listingCount Integer
    createdAt Instant
    updatedAt Instant
}

/** Địa phương (bảng location) */
entity Location(location) {
    /** wp_terms.term_id */
    wpTermId Long unique
    name String required maxlength(255)
    slug String maxlength(255)
    /** province, district, ward */
    type String maxlength(50)
    code String maxlength(50)
    latitude Double
    longitude Double
    createdAt Instant
}

// =====================================================
// 3. BLOG
// =====================================================

/** Bài viết tin tức (bảng blog_post) */
entity BlogPost(blog_post) {
    /** wp_posts.ID */
    wpId Long required unique
    title String required maxlength(500)
    slug String maxlength(500)
    content TextBlob
    excerpt TextBlob
    thumbnail String maxlength(500)
    status String maxlength(50)
    viewCount Integer
    publishedAt Instant
    createdAt Instant
    updatedAt Instant
}

/** Thẻ (bảng tag) */
entity Tag(tag) {
    /** wp_terms.term_id */
    wpTermId Long unique
    name String required maxlength(255)
    slug String maxlength(255)
}

// =====================================================
// RELATIONSHIPS
// =====================================================

// listing_category: Listing N - N Category (một chiều: Category không giữ danh sách listings,
// tránh API /api/categories tải hàng trăm nghìn doanh nghiệp mỗi ngành)
relationship ManyToMany {
    Listing{category(name)} to Category
}

// listing_location: Listing N - N Location (một chiều, cùng lý do)
relationship ManyToMany {
    Listing{location(name)} to Location
}

// category.parent_id: cây ngành nghề
relationship ManyToOne {
    Category{parent(name)} to Category
}

// location.parent_id: tỉnh -> quận/huyện -> phường/xã
relationship ManyToOne {
    Location{parent(name)} to Location
}

// =====================================================
// OPTIONS
// =====================================================

dto * with mapstruct

service * with serviceImpl

paginate Listing, Category, Location, BlogPost with pagination
paginate Tag with infinite-scroll

filter Listing, Category, Location, BlogPost

// Ứng dụng dùng searchEngine elasticsearch (.yo-rc.json)
search * with elasticsearch
