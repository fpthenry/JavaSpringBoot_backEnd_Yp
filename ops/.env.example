# Mật khẩu cho ops/docker-compose.yml (MySQL + Elasticsearch trên server).
# Chép thành ops/.env trên server, điền giá trị thật, chmod 600. KHÔNG commit file .env.
# Tạo mật khẩu ngẫu nhiên: openssl rand -base64 24 | tr -d '/+='

MYSQL_ROOT_PASSWORD=
# Phải TRÙNG DB_PASSWORD trong /opt/yp/backend/.env (user MySQL yp_app)
DB_PASSWORD=
# Phải TRÙNG ELASTICSEARCH_PASSWORD trong /opt/yp/backend/.env (user "elastic")
ELASTIC_PASSWORD=

# Bộ nhớ theo RAM máy chủ — máy 16 GB: MYSQL_BUFFER_POOL=4G, ES_HEAP=4g; máy 8 GB: 2G / 2g
MYSQL_BUFFER_POOL=2G
ES_HEAP=2g
