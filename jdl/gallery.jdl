/**
 * Gallery / banner quảng cáo: quản trị viên tự nhập ảnh, FE lấy qua API công khai.
 * Thay cho post_type gallery của WordPress (footer banner, right banner 1, left center banner...).
 *
 * File này chỉ chứa 2 entity mới để sinh code RIÊNG, không sinh lại các entity cũ (có code sửa tay):
 *   npx jhipster jdl jdl/gallery.jdl
 * Định nghĩa giống hệt cũng được chép vào yp-schema.jdl để yp-schema.jdl vẫn là bản đầy đủ.
 */

/** Vị trí banner (gallery) */
entity Gallery(gallery) {
    /** Tên hiển thị, vd: footer banner */
    name String required maxlength(255)
    /** Mã duy nhất FE dùng để lấy, chữ thường, số và gạch ngang, vd: footer-banner */
    code String required unique maxlength(100) pattern(/^[a-z0-9-]+$/)
    description TextBlob
    /** Tắt thì API công khai không trả vị trí này */
    active Boolean required
    /** ID gallery cũ trên WordPress (wp_posts.ID), để đối chiếu */
    wpId Long unique
}

/** Ảnh quảng cáo trong một vị trí banner */
entity GalleryImage(gallery_image) {
    title String maxlength(255)
    /** Ảnh upload lên (lưu trong database) */
    image ImageBlob
    /** Hoặc link ảnh có sẵn (CDN, wp-content/uploads...); dùng khi không upload */
    imageUrl String maxlength(1000)
    /** Bấm vào ảnh thì mở link này */
    linkUrl String maxlength(1000)
    altText String maxlength(255)
    /** Thứ tự hiển thị, nhỏ đứng trước */
    displayOrder Integer required min(0)
    active Boolean required
    /** Hẹn giờ: chỉ hiển thị từ thời điểm này (bỏ trống = ngay) */
    startAt Instant
    /** Hẹn giờ: ngừng hiển thị sau thời điểm này (bỏ trống = không hết hạn) */
    endAt Instant
    openInNewTab Boolean
}

relationship ManyToOne {
    GalleryImage{gallery(name) required} to Gallery
}

dto Gallery, GalleryImage with mapstruct
service Gallery, GalleryImage with serviceImpl
paginate Gallery, GalleryImage with pagination
filter Gallery, GalleryImage
// Ảnh nhị phân không đưa vào Elasticsearch
search Gallery, GalleryImage with no
