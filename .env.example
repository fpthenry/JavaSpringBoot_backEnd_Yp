# ════════════════════════════════════════════════════════════════════════════════════════
#  BACKEND (JHipster) — BIẾN MÔI TRƯỜNG PRODUCTION       Trang quản trị + API: https://yellowbe.yp.vn
#
#  Cách dùng: chép file này thành ".env" đặt CẠNH file jar (thư mục chạy app), điền giá trị thật.
#    - Hoặc khai báo các biến này làm biến môi trường của server (systemd EnvironmentFile, docker env_file…);
#      biến môi trường thật được ưu tiên hơn file .env.
#    - File .env KHÔNG commit (đã có trong .gitignore). Định dạng: TÊN=giá trị, không dấu ngoặc kép.
#  Build: ./mvnw -Pprod clean package -DskipTests   → profile "prod" đã đóng gói sẵn trong jar.
#  Chạy:  java -jar target/java-spring-boot-back-end-*.jar   (chạy từ thư mục chứa file .env)
#
#  Thiếu biến BẮT BUỘC (*) thì app dừng ngay khi khởi động — cố ý, để không chạy với khóa/tài khoản sai.
#  Đọc tại: src/main/resources/config/application-prod.yml
# ════════════════════════════════════════════════════════════════════════════════════════

# ─── Địa chỉ trang quản trị (*) ─────────────────────────────────────────────────────────
# Dùng cho link trong email (đặt lại mật khẩu). Không có "/" cuối.
APP_BASE_URL=https://yellowbe.yp.vn
SERVER_PORT=8080

# ─── MySQL (*) ──────────────────────────────────────────────────────────────────────────
# Dùng user riêng của app (KHÔNG dùng root), chỉ có quyền trên database của app:
#   CREATE USER 'yp_app'@'localhost' IDENTIFIED BY '<mật khẩu mạnh>';
#   GRANT ALL PRIVILEGES ON javaspringbootbackend.* TO 'yp_app'@'localhost';
DB_URL=jdbc:mysql://localhost:3306/javaspringbootbackend?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&useLegacyDatetimeCode=false
DB_USERNAME=yp_app
DB_PASSWORD=doi-mat-khau-manh

# ─── Elasticsearch ──────────────────────────────────────────────────────────────────────
# Production: bật xác thực (xpack.security.enabled=true) và chỉ mở cổng 9200 trong máy/mạng nội bộ.
ELASTICSEARCH_URIS=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# ─── Khóa ký token đăng nhập (*) ────────────────────────────────────────────────────────
# Tạo: openssl rand -base64 64   (một dòng, bỏ xuống dòng). TUYỆT ĐỐI không dùng khóa trong application-secret-samples.yml.
JWT_BASE64_SECRET=

# ─── Khóa API công khai cho FE Next.js ──────────────────────────────────────────────────
# Tạo: openssl rand -base64 32. Nhiều khóa cách nhau bởi dấu phẩy (để đổi khóa không gián đoạn).
# FE phải dùng ĐÚNG khóa này cho YP_API_KEY. Để trống: mọi request tới /api/public/** bị từ chối.
PUBLIC_API_KEYS=

# ─── Email (đặt lại mật khẩu) ───────────────────────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@yp.vn

# ════════════════════════════════════════════════════════════════════════════════════════
#  SAU LẦN CHẠY ĐẦU TIÊN (bắt buộc)
#   1. Đăng nhập https://yellowbe.yp.vn bằng admin / admin → Tài khoản → Mật khẩu: ĐỔI NGAY.
#   2. Tài khoản mặc định "user" đã tự bị khóa (Liquibase, chỉ ở production).
#   3. Tự đăng ký tài khoản đã tắt; tạo tài khoản quản trị mới trong Quản trị → Quản lý người dùng.
# ════════════════════════════════════════════════════════════════════════════════════════
